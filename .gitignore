# Local Python virtual environment (uv)
.venv/

# Vendor skills folders, generated by agentic/scripts/sync_skills.py
/.claude/skills/
/.opencode/skills/
/.agents/skills/
/.gemini/skills/
/.github/skills/

# Secrets: API keys, never committed
.env

# macOS Finder metadata
.DS_Store

# Local symlinks to folders outside the repo (see AGENTS.md). No trailing
# slash: git treats a symlink as a file, so `.kb/` would not match it.
.kb
.projects
.worktrees

# Local scratch files
.temp/

# Python bytecode and pytest caches
__pycache__/
.pytest_cache/
