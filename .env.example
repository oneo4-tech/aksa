# Copy to .env and fill in. .env is gitignored; never commit real keys.

# OpenRouter
OPENROUTER_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Google AI Studio
GEMINI_API_KEY=

# Google Cloud: an API key with the YouTube Data API v3 enabled
GOOGLE_CLOUD_API_KEY=

# OpenCode: optional session to resume with: opencode -s "$OPENCODE_SESSION_ID"
OPENCODE_SESSION_ID=
