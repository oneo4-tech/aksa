# Copy to .env and fill in. .env is gitignored; never commit real keys.

# OpenRouter
OPENROUTER_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Google AI Studio
GEMINI_API_KEY=

# OpenCode: optional session to resume with: opencode -s "$OPENCODE_SESSION_ID"
OPENCODE_SESSION_ID=

# Models used by the VS Code tasks
CODEX_MODEL=gpt-5.6-luna
GEMINI_MODEL=gemini-2.5-flash
